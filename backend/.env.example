# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database Configuration
# Primary PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Test Database Configuration (Optional, for running tests)
# TEST_DATABASE_URL=postgresql://user:password@host:port/testdb?sslmode=require

# Scraping & Operations
ENABLE_SELENIUM=1
SCRAPING_INTERVAL_HOURS=6
REQUEST_TIMEOUT=30
REALTIME_PLATFORM_TIMEOUT_SEC=60
REALTIME_OVERALL_TIMEOUT_SEC=90

# AI Search Service API Keys
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
